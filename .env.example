# Copy to .env (gitignored) and fill. Never put real values in this file.

# Venues (D2). Only venues with a trading API need keys; read-only venues use public endpoints.
QFEX_API_KEY=
QFEX_API_SECRET=

# Alerts (D4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supervisor LLM (D4): one key per provider actually used; the model per role is in config
LLM_API_KEY=

# Tracing (D4)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
